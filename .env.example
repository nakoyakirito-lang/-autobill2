# WhatsApp & Messenger Configuration
PORT=5000

# ຂໍ້ມູນ Login ຂອງ Anousith Express (NextDay)
ANOUSITH_USERNAME=your_phone_or_username
ANOUSITH_PASSWORD=your_password
ANOUSITH_BASE_URL=https://app.anousith.express

# ຂໍ້ມູນ Login ຂອງ HAL Express
HAL_USERNAME=your_phone_or_username
HAL_PASSWORD=your_password

# ຄວາມຖີ່ໃນການກວດສອບອໍເດີໃໝ່ (ວິນາທີ)
POLL_INTERVAL_SECONDS=60

# ----------------------------------------------------
# Supabase Database Configuration (Optional for cloud deploy)
# ----------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
